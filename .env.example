# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com/api-keys
# Leave RESEND_API_KEY empty in development and emails are logged, not sent.
RESEND_API_KEY=
EMAIL_FROM="SOCIS Incubator <incubator@socis.ca>"
# Address that receives application alerts. EMAIL_FROM must use a verified sending domain.
EMAIL_ADMIN=socis@uoguelph.ca

# Used to build absolute links in emails and auth redirects
# Vercel Production: https://socis-incubator.vercel.app (redeploy after changing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
